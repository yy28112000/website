def place_box(key, tel=None, note=None):

    addr, link = places[key]

    extra = ""

    if tel:

        extra += f'<span>☎ <a href="tel:{tel.replace("-", "")}">{tel}</a></span>'

    if note:

        extra += f'<span>{note}</span>'

